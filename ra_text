<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>만화 말풍선 생성기</title>
    <style>
        :root {
            --primary-color: #4a90e2;
        }
        body {
            display: flex;
            flex-direction: column;
            align-items: center;
            background-color: #f5f5f5;
            font-family: 'Apple SD Gothic Neo', 'Malgun Gothic', sans-serif;
            padding: 20px;
            margin: 0;
        }
        .controls {
            margin-bottom: 20px;
            display: flex;
            gap: 10px;
            background: white;
            padding: 15px;
            border-radius: 10px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }
        .canvas-container {
            position: relative;
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
            line-height: 0;
            background: white;
        }
        /* 입력 영역 스타일 */
        .input-overlay {
            position: absolute;
            left: 50%;
            transform: translateX(-50%);
            width: 60%;
            height: 15%;
            background: rgba(255, 255, 255, 0.1);
            border: 2px dashed transparent;
            text-align: center;
            font-size: 24px;
            font-weight: bold;
            color: black;
            resize: none;
            overflow: hidden;
            outline: none;
            transition: all 0.3s;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .input-overlay:hover, .input-overlay:focus {
            background: rgba(255, 255, 255, 0.5);
            border-color: var(--primary-color);
        }
        #top-input { top: 3%; }
        #bottom-input { bottom: 3%; }

        button {
            padding: 10px 20px;
            font-size: 16px;
            cursor: pointer;
            background-color: var(--primary-color);
            color: white;
            border: none;
            border-radius: 5px;
            transition: background 0.2s;
        }
        button:hover { background-color: #357abd; }
        #guide { color: #666; margin-top: 10px; font-size: 14px; }
    </style>
</head>
<body>

    <h2>만화 말풍선 편집기</h2>
    
    <div class="controls">
        <button onclick="downloadImage()">PNG 이미지로 저장하기</button>
    </div>

    <div class="canvas-container" id="capture-area">
        <img id="source-img" src="sample.png" alt="이미지 로드 중..." crossorigin="anonymous" style="max-width: 500px; display: block;">
        
        <textarea id="top-input" class="input-overlay" placeholder="상단 문구 입력"></textarea>
        <textarea id="bottom-input" class="input-overlay" placeholder="하단 문구 입력"></textarea>
    </div>

    <p id="guide">※ 위/아래 말풍선을 클릭해 글자를 입력하고 저장 버튼을 누르세요.</p>

    <canvas id="export-canvas" style="display:none;"></canvas>

    <script>
        function downloadImage() {
            const canvas = document.getElementById('export-canvas');
            const ctx = canvas.getContext('2d');
            const img = document.getElementById('source-img');
            const topText = document.getElementById('top-input').value;
            const bottomText = document.getElementById('bottom-input').value;

            // 1. 캔버스 크기를 이미지 실제 크기에 맞춤
            canvas.width = img.naturalWidth;
            canvas.height = img.naturalHeight;

            // 2. 이미지 그리기
            ctx.drawImage(img, 0, 0);

            // 3. 텍스트 설정
            const fontSize = Math.floor(canvas.width * 0.05); // 이미지 크기에 비례한 글자 크기
            ctx.font = `bold ${fontSize}px sans-serif`;
            ctx.fillStyle = "black";
            ctx.textAlign = "center";
            ctx.textBaseline = "middle";

            // 4. 상단 텍스트 그리기 (이미지 높이의 약 10% 지점)
            if (topText) {
                const lines = topText.split('\n');
                lines.forEach((line, i) => {
                    ctx.fillText(line, canvas.width / 2, (canvas.height * 0.1) + (i * fontSize * 1.2));
                });
            }

            // 5. 하단 텍스트 그리기 (이미지 높이의 약 90% 지점)
            if (bottomText) {
                const lines = bottomText.split('\n');
                lines.forEach((line, i) => {
                    ctx.fillText(line, canvas.width / 2, (canvas.height * 0.9) - ((lines.length - 1 - i) * fontSize * 1.2));
                });
            }

            // 6. 다운로드 링크 생성
            const link = document.createElement('a');
            link.download = 'manga_result.png';
            link.href = canvas.toDataURL('image/png');
            link.click();
        }
    </script>
</body>
</html>
